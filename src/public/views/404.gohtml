{{define "notfound"}}
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/static/css/style.css">
        <title>{{t "404PageNotFoundHeader"}}</title>
    </head>
    <body>
    <div class="container not-found-container">
        <h1>404</h1>
        <p>{{t "PageNotFoundErrorMessage"}}</p>
        <a class="home-button" onclick="window.location.href='{{reverse "meetings"}}'">{{t "ReturnToIndexLinkText"}}</a>
    </div>
    </body>
    </html>
{{end}}