{{define "report"}}
    <!DOCTYPE html>
    <html lang="{{t "CurrentISO639" }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{t "ReportHeader"}}</title>
        <link rel="stylesheet" href="/static/css/style.css">
        <link rel="stylesheet" href="/static/fontawesome.min.css">
    </head>
    <body>
    <div class="container">
        <div class="action-buttons">
            <button class="action-button" onclick="window.print()">
                <i class="fas fa-print"></i>
                <span>{{t "ReportPrintReportButton"}}</span>
            </button>
            <a class="action-button" href="{{reverse "reportCsv" .InternalMeetingID}}">
                <i class="fas fa-file-excel"></i>
                <span>{{t "ReportOpenInExcelButton"}}</span>
            </a>
            {{ if .MeetingActive }}
                <button class="action-button force-close-button" popovertarget="force-close-modal"
                        title="Force close the meeting for all participants">
                    <i class="fas fa-ban"></i>
                    <span>{{t "ForceCloseMeetingButton"}}</span>
                </button>
            {{ end }}
        </div>

        <div class="card header">
            <h1>{{t "ReportHeader"}}</h1>
        </div>
        <a class="meeting-button report-back-meeting-button" href="{{reverse "meetings"}}" id="topBackToMeetings">
            <i class="fas fa-arrow-left"></i> {{t "BackToMeetingsButton"}}
        </a>

        <!-- Meeting Details -->
        {{template "meetingdetails" .Report.Details}}

        <div class="card" id="gdpr-filter-form-wraper">
            <form id="gdpr-filter-form">
                <span>{{t "MeetingReportMeetingDetailsGDPRCheckbox"}}</span>
                <label class="switch" id="gdpr-label">
                    <input type="checkbox" name="gdpr" {{ if .Gdpr  }}checked{{ end }}>
                    <span class="slider"></span>
                </label>
                <input type="submit" class="search-button" value="{{t "MeetingReportMeetingDetailsGDPRFormSubmit"}}">
            </form>
        </div>

        <!-- Participants -->
        {{template "participants" .}}

        {{ if .MeetingActive }}
            <div class="reload-container" onclick="location.reload()">
                <a href="{{reverse "report" .InternalMeetingID }}?ts={{ timestamp }}" class="reload-button">
                    <i class="fa-solid fa-rotate-right"></i>
                    Reload
                </a>
            </div>
        {{ end }}

        <!-- Recordings -->
        {{ if .Report.Recordings }}
            {{template "inlineRecordings" .Report.Recordings}}
        {{ end }}
        <!-- Timeline -->
        {{template "timeline" .Report.Timeline}}

        <a class="meeting-button report-back-meeting-button" href="{{reverse "meetings"}}" id="bottomBackToMeetings">
            <i class="fas fa-arrow-left"></i> {{t "BackToMeetingsButton"}}
        </a>
    </div>

    <!-- Force Close Confirmation Modal (native popover) -->
    <div id="force-close-modal" class="force-close-modal" popover>
        <div class="modal-header">
            <h2 class="modal-title">{{t "ForceCloseModalTitle"}}{{ .Meeting.Name}}</h2>
        </div>

        <p class="modal-description">
            {{t "ForceCloseModalDescription"}}
        </p>

        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i>
            <div>
                <strong>{{t "ForceCloseModalAlertTitle"}}</strong>
                <span>{{t "ForceCloseModalAlertText"}}</span>
            </div>
        </div>

        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            <div>
                <strong>{{t "ForceCloseModalWarningTitle"}}</strong>
                <span>{{t "ForceCloseModalWarningText"}}</span>
            </div>
        </div>

        <div class="modal-actions">
            <button type="button" class="modal-button cancel-button"
                    onclick="document.getElementById('force-close-modal').hidePopover()">
                {{t "Cancel"}}
            </button>
            <a href="{{reverse "forceCloseMeeting" .InternalMeetingID}}"
               class="modal-button force-button"
               onclick="document.getElementById('force-close-modal').hidePopover();">
                <i class="fas fa-ban"></i>
                {{t "ForceCloseModalContinue"}}
            </a>
        </div>
    </div>

    </body>
    </html>
{{end}}