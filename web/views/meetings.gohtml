{{ define "meetings" }}
	<!DOCTYPE html>
	<html lang="{{t "CurrentISO639"}}">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{t "MeetingListHeader"}}</title>
		<link rel="stylesheet" href="/static/fontawesome.min.css">
		<link rel="stylesheet" href="/static/css/base.css">
		<link rel="stylesheet" href="/static/css/meetings.css">
	</head>
	<body>
	<div class="container">
		<header class="meetings-header">
			<div>
				<h1 class="page-title">{{t "MeetingListHeader"}}</h1>
				<p class="text-muted" style="font-size: 0.9rem; font-weight: 500;">{{t "LiveMonitorandManagement"}}</p>
			</div>
			<div class="nav-group no-print">
				<a href="{{ reverse "meetings" }}" class="control-item active">{{t "Meetings"}}</a>
				<a href="{{ reverse "recordings" }}" class="control-item">{{t "Recordings"}}</a>
				<a href="{{ reverse "statistics" }}" class="control-item">{{t "Statistics"}}</a>
			</div>
		</header>

		<div class="server-grid">
			{{ template "server_diagram" . }}
		</div>

		<div class="filter-bar no-print">
			<form action="{{ reverse "meetings" }}" method="GET" class="filter-form"
			      style="display:flex; width:100%; align-items:center; gap:20px;">
				<div class="search-input-wrapper">
					<i class="fas fa-search text-muted"></i>
					<input type="text" name="query" placeholder="{{t "MeetingsPageSearchPlaceholder"}}"
					       value="{{ .Request.Query }}">
				</div>
				<div class="date-filters">
					<input type="date" name="start-date" value="{{.Request.StartDate}}">
					<span class="text-muted">→</span>
					<input type="date" name="end-date" value="{{.Request.EndDate}}">
				</div>
				<button type="submit" class="btn btn-primary">{{t "MeetingListFilterFilterButton"}}</button>
			</form>
		</div>

		<div class="card meeting-table-card">
			<table class="meeting-table">
				<thead>
				<tr style="background: #f8fafc; border-bottom: 1px solid var(--border);">
					<th style="padding: 16px 32px;"
					    class="card-title">{{t "MeetingsTableFirstColumnMeetingNameAndID"}}</th>
					<th class="card-title hide-mobile">{{t "MeetingsTableSecondColumnServerHostname"}}</th>
					<th class="card-title text-center">{{t "MeetingsTableThrirdColumnUserCount"}}</th>
					<th class="card-title text-right" id="actions-column">{{t "MeetingsTableFourhtColumnActions"}}</th>
				</tr>
				</thead>
				<tbody>
				{{ range .Meetings }}
					<tr>
						<td>
							<div style="display: flex; align-items: center; gap: 10px;">
								{{ if .Active }}<span class="status-pulse"></span>{{ end }}
								<span class="font-bold">{{ .BBBEventsMeeting.Name }}</span>
							</div>
							<span class="font-mono-xs"
							      style="display:block; margin-top:4px;">{{ .BBBEventsMeeting.InternalMeetingID }}</span>
						</td>
						<td class="hide-mobile"><span class="font-mono-xs">{{ .BbbHostname }}</span></td>
						<td class="text-center">
							<span class="user-count-badge">{{ .UserCount }}</span>
						</td>
						<td>
							<div class="action-btns">
								<button popovertarget="inspect-{{ .BBBEventsMeeting.InternalMeetingID }}"
								        class="btn btn-sm" title="Quick Info"
								        style="color: var(--primary) ; anchor-name: CssAnchor-MeetingDetails-{{ .BBBEventsMeeting.InternalMeetingID }}">
									<i class="fas fa-eye"></i> <span>Info</span>
								</button>
								<a href="{{ reverse "report" .BBBEventsMeeting.InternalMeetingID }}" class="btn btn-sm"
								   title="Report">
									<i class="fas fa-chart-bar"></i> <span class="hide-mobile">Report</span>
								</a>
							</div>

							<div id="inspect-{{ .BBBEventsMeeting.InternalMeetingID }}" popover
							     class="info-card-popover card"
							     style="position-anchor: CssAnchor-MeetingDetails-{{ .BBBEventsMeeting.InternalMeetingID }}">
								<div class="popover-header">
									<h3 class="font-bold"
									    style="font-size: 0.9rem; margin:0;">{{ .BBBEventsMeeting.Name }}</h3>
									<button class="btn" style="border:none; padding:4px;"
									        popovertarget="inspect-{{ .BBBEventsMeeting.InternalMeetingID }}"
									        popovertargetaction="hide">
										<i class="fas fa-times"></i>
									</button>
								</div>

								<div class="popover-body">
									<div class="info-grid">
										<div class="info-item">
											<span class="info-label">Start</span>
											<span class="info-value">{{ formatTime .BBBEventsMeeting.CreateTime }}</span>
										</div>
										<div class="info-item">
											<span class="info-label">Ende</span>
											<span class="info-value">{{ if .BBBEventsMeeting.MeetingEnded }}{{ formatTime .BBBEventsMeeting.MeetingEnded }}{{ else }}—{{ end }}</span>
										</div>
										<div class="info-item">
											<span class="info-label">Dauer</span>
											<span class="info-value">
												{{ if .BBBEventsMeeting.MeetingEnded }}
													{{ timeDurationTsPtr .BBBEventsMeeting.CreateTime .BBBEventsMeeting.MeetingEnded }}
												{{ else }}
													{{t "MeetingsPageMettingsDetailOngoingMeeting"}}
												{{end}}
													</span>
										</div>
										<div class="info-item">
											<span class="info-label">{{t "MeetingsMeetingDetailsFirstUserJoined"}}</span>
											<span class="info-value">{{ if .BBBEventsMeeting }}"Hardcoded"{{ else }}—{{ end }}</span>
										</div>
									</div>

									<div class="recording-status-box">
										<div>
											<span class="info-label">{{t "MeetingRecordingStatusHeader"}}</span>
											<span class="info-value" style="font-size: 0.8rem;">
                                            {{ if .BBBEventsMeeting.Record }}{{t "MeetingRecordingEnabled"}}{{ else }}{{t "MeetingRecordingDisabled"}}{{ end }}
                                        </span>
										</div>
										{{ if .BBBEventsMeeting.Record }}
											<a href="{{ reverse "recordings" }}?query={{ .BBBEventsMeeting.InternalMeetingID }}"
											   class="btn btn-primary btn-sm">
												<i class="fas fa-play"></i> {{t "MeetingsPageViewRecording"}}
											</a>
										{{ end }}
									</div>
								</div>

								<div class="popover-footer"
								     style="padding: 12px 20px; border-top: 1px solid var(--border); display: flex; gap: 8px;">
									<a href="{{ reverse "report" .BBBEventsMeeting.InternalMeetingID }}"
									   class="btn btn-sm" style="flex:1; justify-content:center;">
										<i class="fas fa-chart-bar"></i> {{t "MeetingToReport"}}
									</a>
									<a href="{{ reverse "reportCsv" .BBBEventsMeeting.InternalMeetingID }}"
									   class="btn btn-sm btn-excel" style="flex:1; justify-content:center;">
										<i class="fas fa-file-excel"></i> {{t "ReportOpenInExcelButton"}}
									</a>
								</div>
							</div>
						</td>
					</tr>
				{{ end }}
				</tbody>
			</table>
		</div>
	</div>
	</body>
	</html>
{{ end }}