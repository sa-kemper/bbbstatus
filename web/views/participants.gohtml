{{ define "participants" }}
    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 style="margin: 0;">{{t "ReportParticipantsHeader"}}</h2>
            <span class="badge-id">{{ len .Report.Participants }} Personen</span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px;">
            {{ range $index, $p := .Report.Participants }}
                {{/* Der Link umschließt jetzt wieder die gesamte Karte */}}
                <a href="{{ reverse "inspectReport" $.InternalMeetingID }}?{{.InternalUserID}}=on{{ if $.Gdpr }}&gdpr=on{{ end }}"
                   class="participant-card card {{ if eq $index 0 }}is-host{{ end }}"
                   style="display: flex; align-items: center; gap: 16px; padding: 14px 18px; margin-bottom: 0; text-decoration: none; color: inherit; border: 1px solid var(--border); transition: all 0.2s;">

                    <div class="avatar-container {{ if .LeaveTimestamp }}status-left{{ else if not .Muted }}status-speaking{{ else if .ListeningOnly }}status-active{{ else }}status-silent{{ end }}">
                        <div class="status-ring"></div>
                        <div class="avatar">
                            {{ slice .Name 0 1 }}
                        </div>
                    </div>

                    <div style="flex-grow: 1; min-width: 0;">
                        <div style="display: flex; align-items: center; gap: 4px;">
                            <span style="font-weight: 700; font-size: 1rem; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                {{ .Name }}
                            </span>
                            {{ if eq $index 0 }}
                                <span class="host-badge">HOST</span>
                            {{ end }}
                        </div>

                        <div class="device-strip" style="display: flex; gap: 10px; margin-top: 4px;">
                            <i class="fas fa-headset {{ if .ListeningOnly }}active{{ end }}"
                               style="font-size: 0.75rem; color: {{ if .ListeningOnly }}#2563eb{{ else }}#cbd5e1{{ end }};"
                               title="Audio"></i>
                            <i class="fas fa-microphone {{ if not .Muted }}active{{ end }}"
                               style="font-size: 0.75rem; color: {{ if not .Muted }}#2563eb{{ else }}#cbd5e1{{ end }};"
                               title="Mikrofon"></i>
                            <i class="fas fa-video {{ if .Stream }}active{{ end }}"
                               style="font-size: 0.75rem; color: {{ if .Stream }}#8b5cf6{{ else }}#cbd5e1{{ end }};"
                               title="Webcam"></i>

                            {{ if .LeaveTimestamp }}
                                <span style="font-size: 0.6rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-left: auto;">Offline</span>
                            {{ end }}
                        </div>
                    </div>

                    <div style="display: flex; align-items: center; gap: 12px;" class="hide-mobile">
                        <span class="font-mono-xs"
                              style="background: #f1f5f9; padding: 4px 8px; border-radius: 6px; font-weight: 600;">{{ .Role }}</span>
                        <i class="fas fa-chevron-right"
                           style="color: var(--primary); opacity: 0.3; font-size: 0.8rem;"></i>
                    </div>
                </a>
            {{ end }}
        </div>
    </div>
{{ end }}