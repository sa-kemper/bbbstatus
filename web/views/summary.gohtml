{{ define "summary" }}
    <!DOCTYPE html>
    <html lang="{{t "CurrentISO639"}}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{t "StatsPageStatisticsHeader"}}</title>
        <link rel="stylesheet" href="/static/fontawesome.min.css">
        <link rel="stylesheet" href="/static/css/base.css">
        <link rel="stylesheet" href="/static/css/summary.css">
    </head>
    <body>
    <div class="container">

        <div class="layout-container">
            <header class="stats-header">
                <div class="header-left">
                    <nav class="breadcrumb no-print">
                        <a href="{{ reverse "meetings" }}">← {{t "BackToMeetingsButton"}}</a>
                    </nav>
                    <h1 class="page-title">{{t "StatsPageStatisticsHeader"}}</h1>
                </div>

                <div class="header-actions no-print">
                    <button class="btn btn-expandable" onclick="window.print()">
                        <i class="fas fa-print"></i> <span>{{t "ReportPrintReportButton"}}</span>
                    </button>
                    <a class="btn btn-expandable"
                       href="{{ reverse "summaryCsv" }}?startTime={{.Request.StartTime}}&endTime={{.Request.StopTime}}">
                        <i class="fas fa-file-excel"></i> <span>Excel</span>
                    </a>
                </div>
            </header>

            <div class="filter-bar no-print">
                <div class="segmented-control">
                    <a href="{{ reverse "statistics" }}?scope=week" class="control-item">{{t "Week"}}</a>
                    <a href="{{ reverse "statistics" }}?scope=month" class="control-item">{{t "Month"}}</a>
                    <a href="{{ reverse "statistics" }}?scope=year" class="control-item">{{t "Year"}}</a>
                    <a href="{{ reverse "summary" }}" class="control-item active">{{t "Summary"}}</a>
            </div>

                <form class="date-filters" action="{{reverse "summary"}}">
                    <input type="hidden" name="scope" value="year">
                    <div class="filter-input-group">
                        <label>{{t "StatsPageSelectScopeStartTime"}}</label>
                        <input type="date" name="startTime" onblur="this.form.submit();"
                               value="{{ .Request.StartTime }}" min="{{ .Request.StartTimeMin }}"
                               max="{{ .Request.StartTimeMax }}">
                    </div>
                    <div class="filter-divider"></div>
                    <div class="filter-input-group">
                        <label>{{t "StatsPageSelectScopeStopTime"}}</label>
                        <input type="date" name="stopTime" onblur="this.form.submit();"
                               value="{{ .Request.StopTime }}" min="{{ .Request.StartTimeMin }}"
                               max="{{ .Request.StartTimeMax }}">
                    </div>
                    <noscript>
                        <button type="submit" class="btn">OK</button>
                    </noscript>
                </form>
            </div>

            <div class="kpi-grid">
                <div class="card kpi-card">
                    <span class="kpi-label">Gesamtanzahl Meetings</span>
                    <span class="kpi-value">{{ len .Data }}</span> {{/* Beispiel-Logik */}}
                </div>
                <div class="card kpi-card">
                    <span class="kpi-label">Zeitraum</span>
                    <span class="kpi-value text-sm"
                          style="font-size: 1rem;">{{ .Request.StartTime }} - {{ .Request.StopTime }}</span>
                </div>
                <div class="card kpi-card">
                    <span class="kpi-label">Status</span>
                    <span class="kpi-value"><i class="fas fa-check-circle text-success"></i> Aktiv</span>
                </div>
            </div>

            <div class="card table-card">
                <h2 class="card-title">{{t "StatsPageStatisticsOverviewHeader"}}</h2>
                <div class="table-responsive">
                <table class="stats-table">
                    <thead>
                    <tr>
                        <th>{{t "Month"}}</th>
                        <th>{{t "SummaryMeetingName"}}</th>
                        <th class="text-center">{{t "SummaryUserCount"}}</th>
                        <th class="text-right">{{t "SummaryDuration"}}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{ range .Data }}
                        <tr class="month-divider">
                            <td colspan="4">{{t .Name }}</td>
                        </tr>
                        {{ range .Items }}
                            <tr>
                                <td class="col-date">{{ formatDate .Date }}</td>
                                <td class="col-name font-bold">{{ .MeetingName }}</td>
                                <td class="col-users text-center">
                                    <span class="user-badge">{{ .UserCount }}</span>
                                </td>
                                <td class="col-duration text-right font-mono">{{ formatDuration .Duration }}</td>
                            </tr>
                        {{ end }}
                    {{ end }}
                    </tbody>
                </table>
            </div>
        </div>
        </div>

    </div>
    </body>
    </html>
{{ end }}