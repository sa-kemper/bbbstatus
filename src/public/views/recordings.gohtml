{{ define "recordings" }}
	<!DOCTYPE html>
	<html lang="{{t "CurrentISO639"}}">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{t "RecordingsPageTitle"}}</title>
		<link rel="stylesheet" href="/static/css/style.css">
		<link rel="stylesheet" href="/static/fontawesome.min.css">
	</head>
	<body class="recordings-page">
	<div class="container recordings-container">
		<!-- Header -->
		<div class="header recordings-header animate-slide-in" style="--animation-order: 1;">
			<h1><i class="fas fa-video"></i> {{t "RecordingsPageTitle"}}</h1>
			<a href="{{ reverse "meetings" }}" class="home-button recordings-home-button"><i
						class="fas fa-home"></i> {{t "BackToMeetingsButton"}}</a>
		</div>

		<!-- Search and Filters -->
		<div class="search-filter animate-fade-in" style="--animation-order: 2;">
			<form class="search-form" method="GET" action="/recordings">
				<div class="search-input-wrapper">
					<i class="fas fa-search search-icon"></i>
					<input type="text" name="query" placeholder="{{t "RecordingsPageSearchBar"}}"
						   value="{{.Request.Query}}">
				</div>
				<div class="filter-group">
					<label for="start-date">{{t "MeetingListFilterStartDate"}}</label>
					<input type="date" name="start-date" id="start-date" value="{{.Request.StartDate}}">
				</div>
				<div class="filter-group">
					<label for="end-date">{{t "MeetingListFilterEndDate"}}</label>
					<input type="date" name="end-date" id="end-date" value="{{.Request.EndDate}}">
				</div>
				<button type="submit" class="search-button"><i
							class="fas fa-filter"></i> {{t "MeetingListFilterFilterButton"}}</button>
			</form>
		</div>

		<!-- Recordings List -->
		<div class="recordings-grid animate-fade-in" style="--animation-order: 3;">
            {{range .Recordings.Recording}}
				<div class="recording-card">
					<div class="recording-header">
						<h2>{{.Name}}</h2>
						<span class="status-badge status-{{if .Published}}published{{else}}unpublished{{end}}">
                        {{if .Published}}{{t "RecordingPageRecordingState-published"}}{{else}}{{t "RecordingPageRecordingState-unpublished"}}{{end}}
                    </span>
					</div>
					<div class="recording-meta">
						<div class="meta-item">
							<span class="meta-label">{{t "RecordingPageRecordingMeetingID"}}:</span>
							<span class="meta-value">{{.MeetingID}}</span>
						</div>
						<div class="meta-item">
							<span class="meta-label">{{t "ReportParticipantsHeader"}}:</span>
							<span class="meta-value">{{.Participants}}</span>
						</div>
						<div class="meta-item">
							<span class="meta-label">{{t "MeetingListFilterStartDate"}}:</span>
							<span class="meta-value">{{formatDate .StartDate}}</span>
						</div>
						<div class="meta-item">
							<span class="meta-label">{{t "RecordingPageRecordingDuration"}}:</span>
							<span class="meta-value">{{(index .Playback.Format 0).Length}} mins</span>
						</div>
                        {{if .IsBreakout}}
							<div class="meta-item">
								<span class="meta-label">{{t "RecordingPageRecordingType"}}:</span>
								<span class="meta-value">{{t "RecordingPageRecordingBreakout"}}</span>
							</div>
                        {{end}}
					</div>
					<div class="recording-actions">
                        {{range .Playback.Format}}
							<a href="{{.Url}}" class="recording-link recordings-play-link" target="_blank">
								<i class="fas fa-play"></i> {{t "RecordingPageRecordingPlay"}} {{.Type}}
							</a>
                        {{end}}
					</div>
				</div>
            {{else}}
				<div class="not-found-container recordings-not-found animate-fade-in" style="--animation-order: 3;">
					<h1>{{t "RecordingPageNoRecordingsFound"}}</h1>
					<p>{{t "RecordingPageNoRecordingsFoundHint"}}</p>
				</div>
            {{end}}
		</div>
	</div>
	</body>
	</html>
{{ end }}