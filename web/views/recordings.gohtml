{{ define "recordings" }}
	<!DOCTYPE html>
	<html lang="{{t "CurrentISO639"}}">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{t "RecordingsPageTitle"}}</title>
		<link rel="stylesheet" href="/static/fontawesome.min.css">
		<link rel="stylesheet" href="/static/css/base.css">
		<link rel="stylesheet" href="/static/css/recordings.css">
	</head>
	<body>
	<div class="container">
		<header class="page-header">
			<div class="header-left">
				<div class="header-icon"><i class="fas fa-video"></i></div>
				<h1 class="page-title">{{t "RecordingsPageTitle"}}</h1>
			</div>
			<a href="{{ reverse "meetings" }}" class="btn btn-expandable no-print">
				<i class="fas fa-home"></i> <span>{{t "BackToMeetingsButton"}}</span>
			</a>
		</header>

		<div class="filter-bar no-print">
			<form class="filter-form" method="GET" action="/recordings">
				<div class="search-group">
					<i class="fas fa-search"></i>
					<input type="text" name="query" placeholder="{{t "RecordingsPageSearchBar"}}"
					       value="{{.Request.Query}}">
				</div>
				<div class="date-group">
					<div class="filter-input-group">
						<label for="start-date">{{t "MeetingListFilterStartDate"}}</label>
						<input type="date" name="start-date" id="start-date" value="{{.Request.StartDate}}">
					</div>
					<div class="filter-input-group">
						<label for="end-date">{{t "MeetingListFilterEndDate"}}</label>
						<input type="date" name="end-date" id="end-date" value="{{.Request.EndDate}}">
					</div>
				</div>
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-filter"></i> {{t "MeetingListFilterFilterButton"}}
				</button>
			</form>
		</div>

		<div class="recording-grid">
			{{range .Recordings.Recording}}
				<div class="card recording-card">
					<div class="card-header-flex">
						<h2 class="recording-title">{{.Name}}</h2>
						<span class="status-badge status-{{if .Published}}published{{else}}unpublished{{end}}">
                            {{if .Published}}{{t "RecordingPageRecordingState-published"}}{{else}}{{t "RecordingPageRecordingState-unpublished"}}{{end}}
                        </span>
					</div>

					<div class="recording-details">
						<div class="detail-item">
							<span class="detail-label">{{t "RecordingPageRecordingMeetingID"}}</span>
							<span class="detail-value font-mono truncate" title="{{.MeetingID}}">{{.MeetingID}}</span>
						</div>
						<div class="detail-item">
							<span class="detail-label">{{t "ReportParticipantsHeader"}}</span>
							<span class="detail-value">{{.Participants}}</span>
						</div>
						<div class="detail-item">
							<span class="detail-label">{{t "MeetingListFilterStartDate"}}</span>
							<span class="detail-value">{{formatDate .StartDate}}</span>
						</div>
						<div class="detail-item">
							<span class="detail-label">{{t "RecordingPageRecordingDuration"}}</span>
							<span class="detail-value">{{(index .Playback.Format 0).Length}} mins</span>
						</div>
						{{if .IsBreakout}}
							<div class="detail-item breakout-badge">
								<span class="detail-label">{{t "RecordingPageRecordingType"}}</span>
								<span class="detail-value"><i
											class="fas fa-puzzle-piece"></i> {{t "RecordingPageRecordingBreakout"}}</span>
							</div>
						{{end}}
					</div>

					<div class="action-grid">
						{{range .Playback.Format}}
							<a href="{{.Url}}" class="btn btn-play {{if eq .Type "video"}}btn-full{{end}}"
							   target="_blank">
								<i class="fas {{if eq .Type "video"}}fa-circle-play{{else if eq .Type "statistics"}}fa-chart-simple{{else if eq .Type "notes"}}fa-file-lines{{else}}fa-play{{end}}"></i>
								{{if eq .Type "video"}}{{t "RecordingPageRecordingPlay"}}{{end}} {{.Type}}
							</a>
						{{end}}
					</div>
				</div>
			{{else}}
				<div class="card not-found-card">
					<i class="fas fa-magnifying-glass"></i>
					<h1>{{t "RecordingPageNoRecordingsFound"}}</h1>
					<p>{{t "RecordingPageNoRecordingsFoundHint"}}</p>
				</div>
			{{end}}
		</div>
	</div>
	</body>
	</html>
{{ end }}