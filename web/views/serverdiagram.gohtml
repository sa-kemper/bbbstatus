{{ define "server_diagram" }}
	{{ range .ServerStats.ServerCounts }}
		<div class="card server-card {{ if gt .Meetings 0 }}active{{ end }}">
			<div style="display: flex; justify-content: space-between; align-items: flex-start;">
				<span class="font-mono-xs" style="font-weight: 800;">{{ .Hostname }}</span>
				{{ if gt .Meetings 0 }}
					<span class="badge-id" style="background: #dcfce7; color: #166534; border:none; font-size:0.6rem;">Online</span>
				{{ else }}
					<span class="badge-id" style="background: #f1f5f9; color: #64748b; border:none; font-size:0.6rem;">Idle</span>
				{{ end }}
			</div>

			<div class="server-stats-row">
				<div>
					<span style="display:block; font-size: 1.5rem; font-weight: 800; line-height:1;">{{ .Meetings }}</span>
					<span class="font-mono-xs" style="text-transform: uppercase;">Meetings</span>
				</div>
				<div style="text-align: right;">
					{{/* Wir suchen die User-Anzahl aus dem ServerFilter-Request */}}
					{{ $hostname := .Hostname }}
					{{ range $.Request.ServerFilter }}
						{{ if eq .Hostname $hostname }}
							<span style="display:block; font-size: 1.5rem; font-weight: 800; line-height:1;">{{ .Users }}</span>
							<span class="font-mono-xs" style="text-transform: uppercase;">Users</span>
						{{ end }}
					{{ end }}
				</div>
			</div>
		</div>
	{{ end }}
{{ end }}